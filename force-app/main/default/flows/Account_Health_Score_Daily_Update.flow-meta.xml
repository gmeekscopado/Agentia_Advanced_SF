<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Green_Score</name>
        <label>Assign Green Score</label>
        <locationX>302</locationX>
        <locationY>1440</locationY>
        <assignmentItems>
            <assignToReference>Loop_Accounts.Health_Score__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Green</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Accounts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Red_Score</name>
        <label>Assign Red Score</label>
        <locationX>50</locationX>
        <locationY>1440</locationY>
        <assignmentItems>
            <assignToReference>Loop_Accounts.Health_Score__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Red</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Accounts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Yellow_Score</name>
        <label>Assign Yellow Score</label>
        <locationX>176</locationX>
        <locationY>1440</locationY>
        <assignmentItems>
            <assignToReference>Loop_Accounts.Health_Score__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Yellow</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Accounts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Increment_No_Activity</name>
        <label>Increment For No Activity</label>
        <locationX>50</locationX>
        <locationY>600</locationY>
        <assignmentItems>
            <assignToReference>varUnfavorableCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Auto_Red_Activity</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Reset_Unfavorable_Count</name>
        <label>Reset Unfavorable Count</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <assignmentItems>
            <assignToReference>varUnfavorableCount</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Last_Activity</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Auto_Red_Activity</name>
        <label>No Activity Equals Auto Red</label>
        <locationX>50</locationX>
        <locationY>720</locationY>
        <defaultConnector>
            <targetReference>Determine_Final_Score</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Continue Scoring</defaultConnectorLabel>
        <rules>
            <name>Auto_Red_No_Activity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varUnfavorableCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Red_Score</targetReference>
            </connector>
            <label>Auto Red From No Activity</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Last_Activity</name>
        <label>Check Last Activity</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <defaultConnector>
            <targetReference>Determine_Final_Score</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Activity Within 60 Days (Favorable)</defaultConnectorLabel>
        <rules>
            <name>No_Recent_Activity</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Accounts.LastActivityDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Accounts.LastActivityDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>frmSixtyDaysAgo</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Increment_No_Activity</targetReference>
            </connector>
            <label>No Recent Activity (Unfavorable)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Determine_Final_Score</name>
        <label>Determine Final Score</label>
        <locationX>176</locationX>
        <locationY>1320</locationY>
        <defaultConnector>
            <targetReference>Assign_Green_Score</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Green (0 Unfavorable)</defaultConnectorLabel>
        <rules>
            <name>Score_Is_Red</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varUnfavorableCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Red_Score</targetReference>
            </connector>
            <label>Red (2 or More Unfavorable)</label>
        </rules>
        <rules>
            <name>Score_Is_Yellow</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varUnfavorableCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Yellow_Score</targetReference>
            </connector>
            <label>Yellow (1 Unfavorable)</label>
        </rules>
    </decisions>
    <description>Scheduled Flow that runs daily at 2:00 AM to recalculate the Health Score field on all Accounts based on Last Activity Date, Open Critical Cases, and Active Contracts.</description>
    <formulas>
        <name>frmSixtyDaysAgo</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 60</expression>
    </formulas>
    <interviewLabel>Account Health Score Daily Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Health Score Daily Update</label>
    <loops>
        <name>Loop_Accounts</name>
        <label>Loop Accounts</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <collectionReference>varAccountsToUpdate</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Reset_Unfavorable_Count</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Accounts</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_All_Accounts</name>
        <label>Get All Accounts</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Accounts</targetReference>
        </connector>
        <object>Account</object>
        <outputReference>varAccountsToUpdate</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>LastActivityDate</queriedFields>
        <queriedFields>Health_Score__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_Accounts</name>
        <label>Update Accounts</label>
        <locationX>176</locationX>
        <locationY>1560</locationY>
        <inputReference>varAccountsToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_All_Accounts</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-08-01</startDate>
            <startTime>02:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varAccountsToUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>
        <name>varUnfavorableCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
    </variables>
</Flow>
