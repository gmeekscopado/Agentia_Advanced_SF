    <description>Screen Flow to guide Sales Representatives through the Lead Conversion process. Creates Account, Contact, and Opportunity records and marks the Lead as Converted.</description>
    <formulas>
        <name>frmFinalAccountId</name>
        <dataType>String</dataType>
        <expression>IF({!varUseExistingAccount}, {!varSelectedAccountId}, {!varNewAccountId})</expression>
    </formulas>
    <formulas>
        <name>frmIsLeadValid</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!varLead.Company})) &amp;&amp; NOT(ISBLANK({!varLead.Email})) &amp;&amp; NOT(ISBLANK({!varLead.Phone}))</expression>
    </formulas>
    <interviewLabel>Lead Conversion Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead Conversion Flow</label>
    <processMetadataValues>
