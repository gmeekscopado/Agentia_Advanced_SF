<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Historical_Must_Be_Inactive</fullName>
    <active>true</active>
    <description>Historical Franchise records cannot be marked active.</description>
    <errorConditionFormula>AND(RecordType.DeveloperName = &apos;Historical_Franchise&apos;, Is_Active__c = true)</errorConditionFormula>
    <errorDisplayField>Is_Active__c</errorDisplayField>
    <errorMessage>A Historical Franchise cannot be marked as active.</errorMessage>
</ValidationRule>
